{
  "name": "browser-seo-crawler",
  "version": "1.0.0",
  "description": "Headless Chromium browser-based crawler for dynamic JS and Kentico SEO content",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "postinstall": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright install chromium",
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "dependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "playwright": "^1.49.1"
  }
}
